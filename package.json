{
  "name": "air-choose",
  "version": "0.1.0",
  "description": "MCP server that monitors flight prices across multiple provider APIs and lets an AI agent add/remove/inspect watched routes",
  "type": "module",
  "bin": {
    "air-choose": "./src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/unit/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node test/e2e/full-flow.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:all": "node --test test/unit/*.test.mjs && node test/e2e/full-flow.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  }
}
